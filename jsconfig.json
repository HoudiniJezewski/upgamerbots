{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",

    "allowJs": true,
    "checkJs": true,

    "baseUrl": ".",
    "types": ["node"],

    "noEmit": true,
    "strict": false
  },
  "include": ["**/*.js", "**/*.d.ts"],
  "exclude": ["node_modules"]
}